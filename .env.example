# Server-only PostgreSQL connection string.
# Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Preferred: per-node credentials. Keep this JSON server-side.
# Tokens should be long random values (24+ characters).
GRIDPULSE_NODE_TOKENS={"NODE-001":"replace-with-a-long-random-secret"}

# Legacy/single-node fallback. Used only when GRIDPULSE_NODE_TOKENS is absent.
# GRIDPULSE_INGEST_TOKEN=replace-with-a-long-random-secret

# Optional. Defaults to TLS enabled.
# Set only for local PostgreSQL development.
# DATABASE_SSL=disable
