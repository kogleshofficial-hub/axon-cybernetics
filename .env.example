# Server-only PostgreSQL connection string.
# Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Shared secret used by Yenna's telemetry node(s).
# Use a long random value and keep it server-side.
GRIDPULSE_INGEST_TOKEN=replace-with-a-long-random-secret

# Optional. Defaults to TLS enabled.
# Set only for local PostgreSQL development.
# DATABASE_SSL=disable
